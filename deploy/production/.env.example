BACKEND_CONTAINER_NAME=your_production_backend_contanier_name
SPRING_PROFILES_ACTIVE=prod

IMAGE_TAG=prod

# ===============================
# Application / Server
# ===============================
SERVER_PORT=your_production_server_port

# ===============================
# PostgreSQL Datasource
# ===============================
POSTGRES_HOST=your_postgresql_host
POSTGRES_PORT=your_postgresql_port
POSTGRES_NAME=your_production_postgresql_name
POSTGRES_USERNAME=your_postgresql_username
POSTGRES_PASSWORD=your_postgresql_password

# ===============================
# Redis
# ===============================
REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=your_production_redis_number

# ===============================
# File Upload (Spring Multipart)
# ===============================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# jwt
JWT_ISSUER=issuer
JWT_SECRET_KEY=jwt_secret_key

GROUP_ACCOUNT_LINK=your_group_account_link
GROUP_ACCOUNT_NUMBER=your_group_account_number